#include <bits/stdc++.h>
using namespace std;
int max_int(unordered_map<char,int>& freq){
    int mx=0;
    for(auto it:freq){
        mx=max(mx,it.second);
    }
    return mx;
}

class Solution {
  public:
    int longestSubstr(string& s, int k) {
        // code here
        int n=s.size();
        unordered_map<char,int> freq;
        int low=0,high=0;
        int res=INT_MIN;
        for(high=0;high<n;high++){
            freq[s[high]]++;
            int len=high-low+1;
            int max_frequency=max_int(freq);
            int diff=len-max_frequency;
        while(diff>k){
            freq[s[low]]--;
            low++;
            len=high-low+1;
            max_frequency=max_int(freq);
            diff=len-max_frequency;
        }
        res=max(res,len);
        }
        return res;
    }
};
